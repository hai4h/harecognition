/* HARecognition dark theme (base stylesheet) */
QMainWindow, QWidget {
    background-color: #1e1e1e;
    color: #e0e0e0;
    font-family: "DejaVu Sans", sans-serif;
    font-size: 13px;
}

QStatusBar {
    background-color: #141414;
    color: #9e9e9e;
}

QPushButton {
    background-color: #2d2d2d;
    border: 1px solid #444444;
    border-radius: 4px;
    padding: 6px 14px;
    color: #e0e0e0;
}
QPushButton:hover { background-color: #3a3a3a; }
QPushButton:checked { background-color: #0d6efd; border-color: #0d6efd; color: white; }

QComboBox {
    background-color: #2d2d2d;
    border: 1px solid #444444;
    border-radius: 4px;
    padding: 4px 8px;
}
QComboBox QAbstractItemView {
    background-color: #2d2d2d;
    selection-background-color: #0d6efd;
}

QLabel#modeStateLabel { font-size: 16px; font-weight: bold; }
QLabel#modeStateLabel[state="align"]   { color: #ffc107; }
QLabel#modeStateLabel[state="gesture"] { color: #ff9800; }
QLabel#modeStateLabel[state="success"] { color: #4caf50; }